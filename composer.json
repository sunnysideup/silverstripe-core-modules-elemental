{
    "name": "sunnysideup/core-modules-elemental",
    "type": "silverstripe-recipe",
    "description": "Core modules for Silverstripe CMS for Elemental",
    "require": {
        "dnadesign/silverstripe-elemental": "^6.0",
        "dnadesign/silverstripe-elemental-userforms": "^5.0",
        "sunnysideup/core-modules": "dev-main",
        "sunnysideup/silverstripe-elemental-modeladmin": "dev-main",
        "sunnysideup/elemental-edit-me-button": "dev-main",
        "sunnysideup/elemental-switch-tabs": "dev-main0",
        "sunnysideup/elemental-template": "dev-main",
        "sunnysideup/preview-all-elements": "dev-main",
        "sunnysideup/remove-orphaned-elementals": "dev-main",
        "dnadesign/silverstripe-elemental-virtual": "*",
        "sunnysideup/core-modules": "dev-main"        
    },
    "require-dev": {},
    "suggest": {
        "maxime-rainville/anyfield": "Removed by the Silverstripe 6 upgrade, not compatible yet (no-compatible-stable-release). Was ^0.1 in require. Fix it by hand, then run: composer require maxime-rainville/anyfield:^0.1"
    },
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nicolaas Francken",
            "email": "modules@sunnysideup.co.nz",
            "role": "lead developer"
        }
    ],
    "prefer-stable": true,
    "minimum-stability": "dev",
    "prefer": "source",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
