{
    "name": "sunnysideup/core-modules-elemental",
    "type": "silverstripe-recipe",
    "description": "Core modules for Silverstripe CMS for Elemental",
    "require": {
        "dnadesign/silverstripe-elemental": "^5",
        "dnadesign/silverstripe-elemental-userforms": "^4",
        "dnadesign/silverstripe-elemental-virtual": "^2",
        "sunnysideup/core-modules": "^5.0-dev",
        "sunnysideup/silverstripe-elemental-modeladmin": "^5.0-dev",
        "sunnysideup/elemental-edit-me-button": "^5.0-dev",
        "sunnysideup/elemental-switch-tabs": "^5.0-dev",
        "sunnysideup/elemental-template": "^5.0-dev",
        "sunnysideup/preview-all-elements": "^5.0-dev",
        "maxime-rainville/anyfield": "^0.1",
        "sunnysideup/remove-orphaned-elementals": "^5.0-dev"
    },
    "require-dev": [],
    "suggest": {
        "sunnysideup/core-modules": "dev-master"
    },
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nicolaas Francken",
            "email": "modules@sunnysideup.co.nz",
            "role": "lead developer"
        }
    ],
    "prefer-stable": true,
    "minimum-stability": "dev",
    "prefer": "source",
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
